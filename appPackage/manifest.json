{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Sovereign Bank",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/termofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Sovereign Compliance${{APP_NAME_SUFFIX}}",
    "full": "Sovereign Compliance Copilot"
  },
  "description": {
    "short": "FCA compliance specialist for Sovereign Bank",
    "full": "A scoped Microsoft 365 Copilot experience for the Sovereign Bank compliance team, grounded in FCA regulations and internal compliance policies."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "validDomains": []
}